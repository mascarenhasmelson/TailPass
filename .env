POSTGRES_USER=admin
POSTGRES_PASSWORD=StrongPassword123
POSTGRES_DB=tunnel_services
POSTGRES_PORT=5432
VITE_API_URL=http://localhost:8082

# --- Authentication ---
# Set this to a long, random string in production (e.g. `openssl rand -hex 32`).
# If left blank, TailPass generates a random one at startup, which means all
# sessions are invalidated every time the backend restarts.
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Set to "true" once TailPass is served over HTTPS so the refresh-token
# cookie requires a secure connection. Keep "false" for plain-HTTP LAN/Tailscale use.
COOKIE_SECURE=false
